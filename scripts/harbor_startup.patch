+    async def _shutdown_owned_server(self) -> bool:
+        """Never accept another listener's identity or call a legacy shutdown URL."""
+        if not self._http_client or not self._server_port or not self._server_token:
+            return False
+        url = f"http://127.0.0.1:{self._server_port}"
+        try:
+            health = await self._http_client.get(f"{url}/health", timeout=0.5)
+            identity = health.json() if health.status_code == 200 else None
+            if (
+                not isinstance(identity, dict)
+                or identity.get("instance_token") != self._server_token
+            ):
+                return False
+            reply = await self._http_client.post(
+                f"{url}/shutdown/{self._server_token}", timeout=0.5
+            )
+            if reply.status_code != 200:
+                return False
+            deadline = asyncio.get_running_loop().time() + 2.0
+            while asyncio.get_running_loop().time() < deadline:
+                await asyncio.sleep(0.1)
+                try:
+                    health = await self._http_client.get(f"{url}/health", timeout=0.3)
+                    identity = health.json() if health.status_code == 200 else None
+                    if (
+                        isinstance(identity, dict)
+                        and identity.get("instance_token") != self._server_token
+                    ):
+                        return True  # Port reused: never send the replacement a shutdown.
+                except httpx.ConnectError:
+                    return True
+                except (httpx.RequestError, ValueError):
+                    pass
+            return False
+        except (httpx.RequestError, ValueError):
+            return False
+
+    async def _stop_server_process(self) -> bool:
+        """Bounded cleanup of this launcher's handle; no process-name or port kills."""
+        try:
+            confirmed = await asyncio.wait_for(
+                self._shutdown_owned_server(), timeout=4.0
+            )
+        except asyncio.TimeoutError:
+            confirmed = False
+        if not confirmed and self._server_token:
+            self._preserve_startup_log = True
+        if self._server_process and self._server_process.returncode is None:
+            try:
+                self._server_process.terminate()
+            except ProcessLookupError:
+                pass
+            try:
+                await asyncio.wait_for(self._server_process.wait(), timeout=5.0)
+            except asyncio.TimeoutError:
+                try:
+                    self._server_process.kill()
+                except ProcessLookupError:
+                    pass
+                try:
+                    await asyncio.wait_for(self._server_process.wait(), timeout=2.0)
+                except asyncio.TimeoutError:
+                    self._preserve_startup_log = True
+                    self.logger.warning("Launcher exit unconfirmed; retained startup log")
+        if self._http_client:
+            try:
+                await asyncio.wait_for(self._http_client.aclose(), timeout=2.0)
+            except asyncio.TimeoutError:
+                self.logger.warning("HTTP client close timed out")
+            self._http_client = None
+        return confirmed
